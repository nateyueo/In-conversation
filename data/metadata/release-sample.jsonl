{"id": "official:sentence:28d11a5f-548b-48ac-a6fc-1dcd436d0423", "recordVersion": 1, "kind": "sentence", "text": "隐约遥峰，和泪谢娘眉妩。", "shortMeaning": "", "genre": "classic", "category": "古典诗词", "tags": ["writing"], "usageNote": "", "publicationStatus": "published", "sources": [{"id": "chinese-poetry:song300-179", "type": "public_domain_text", "title": "《绮罗香》", "quote": null, "locator": "史达祖", "url": "https://github.com/chinese-poetry/chinese-poetry/blob/master/%E5%AE%8B%E8%AF%8D/%E5%AE%8B%E8%AF%8D%E4%B8%89%E7%99%BE%E9%A6%96.json", "edition": "chinese-poetry @2026-10-24（宋词三百首）", "licenseName": "公有领域原文（宋代作品）；仓库整理层 MIT", "licenseUrl": "https://github.com/chinese-poetry/chinese-poetry/blob/master/LICENSE", "attribution": "史达祖《绮罗香》，宋代作品，原文属公有领域；文本整理取自 chinese-poetry 仓库。未使用任何现代译文或注释。", "evidenceStatus": "source_checked", "rightsStatus": "public_domain"}]}
