{"id": "official:sentence:3e5e816d-7373-4aa4-8604-2920f5691b17", "text": "我想知道人们为什么都盯着我。", "shortMeaning": "我想知道人们为什么都盯着我看。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:417d7a1c-06aa-4c84-b50a-d4de5cfce499", "text": "我想知道他们在哪。", "shortMeaning": "我想知道他们在哪儿。", "authoredOn": "2026-10-24"}
