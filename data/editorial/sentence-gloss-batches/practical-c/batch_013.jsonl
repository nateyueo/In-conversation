{"id": "official:sentence:5f8ae43d-6ad2-4cf5-9610-394e89a8a128", "text": "请把我送到家门口。", "shortMeaning": "麻烦把我送到家门前。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:ec82f035-4448-4daa-9e45-b47eb3ae28df", "text": "请把打印机里面的空的墨粉鼓换掉。", "shortMeaning": "请把打印机里空了的墨粉鼓换掉。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:9febe70c-eef2-45cc-bd3e-30c0d2e51cc4", "text": "请把报纸拿来给我。", "shortMeaning": "请把报纸给我拿过来。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:c89027cc-735a-4b12-8c48-8ef2f479694a", "text": "请把每一页复印三份。", "shortMeaning": "每一页都请复印三份。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:711e74d8-abba-46f5-97a8-3587992e872d", "text": "请把淋湿的伞放到这个袋子里。", "shortMeaning": "把湿伞放进这个袋子里。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:13d330ea-2a18-44ff-8079-46f1424712fd", "text": "请把电视机关掉好吗？", "shortMeaning": "能把电视关一下吗？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:343b4598-f853-40d1-bed8-1e78837e4172", "text": "请把盐和胡椒粉拿给我。", "shortMeaning": "请把盐和胡椒递给我。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:35ae4f79-f248-4633-9311-7acec0b58c18", "text": "请把真实的情况说出来。", "shortMeaning": "请把真实情况讲出来。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:39dd145f-11f7-46e1-860f-1eb0b827cac7", "text": "请把这个翻译成德语。", "shortMeaning": "请把这个译成德语。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:157493e6-188a-40c0-ab69-a86a48561218", "text": "请把这些数字合计一下。", "shortMeaning": "请把这些数加起来。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:dce41a5c-f203-4c68-9818-9878341d13cb", "text": "请把这份文档复印五遍。", "shortMeaning": "这份文件请复印五份。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:07c60ae3-7aad-433b-a511-b2c73ba61df7", "text": "请把这张桌子移开。", "shortMeaning": "请把这张桌子挪开。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:c47650db-9138-447e-9a57-ae84fe21dca9", "text": "请把这段日文翻译为法文。", "shortMeaning": "请把这段日文译成法文。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:9a4bb866-2fd3-4320-a1a7-ac296f1e94bb", "text": "请把进展情况报告一下。", "shortMeaning": "请说说进展如何。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:a23fe7b0-6df4-4a94-ad87-39425dc16ec8", "text": "请拼一下您的名字。", "shortMeaning": "请把您的名字拼一下。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:391e22a9-82f9-43d3-a67c-650d5349dffd", "text": "请放走笼中的鸟儿。", "shortMeaning": "请把笼里的鸟放走。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:a9b06e55-d7cb-4da3-84b2-95436d3835ab", "text": "请替我向你父亲问好。", "shortMeaning": "请代我向你父亲问安。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:0af96581-6399-429d-9e6b-1211a2528601", "text": "请来两份香草冰激凌。", "shortMeaning": "请来两份香草冰淇淋。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:1bcf7adc-4bb0-4286-afd2-5480b71c84e3", "text": "请来我办公室一趟。", "shortMeaning": "请到我办公室来一趟。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:8b755ea2-b14d-414e-9c63-7f46444083a1", "text": "请沿着这条路一直往前走。", "shortMeaning": "请顺这条路一直走。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:2e7b1426-dcac-44e4-8258-bd7a2083ea36", "text": "请沿着这条路走，在银行那里向右转。", "shortMeaning": "顺这条路走，到银行那儿往右拐。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:7ac5d069-599e-4a9f-85a1-bf1bff1af263", "text": "请注意防范强降水可能引发的山洪、滑坡、泥石流和城乡积涝等次生灾害！", "shortMeaning": "强降雨可能引发山洪、滑坡、泥石流和积水，请注意防范！", "authoredOn": "2026-10-24"}
{"id": "official:sentence:53e27602-0f12-40ba-846f-bb865733fd2b", "text": "请用正楷签名，不要写连笔字。", "shortMeaning": "请用正楷签字，别写连笔。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:01841e82-1517-479d-a1cd-132ca289625c", "text": "请用英语和我交谈。", "shortMeaning": "请用英语跟我说话。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:fa108314-623d-4a15-ac96-2a5fd52ac998", "text": "请用铅笔写您的名字。", "shortMeaning": "请用铅笔写下您的名字。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:4afbacfb-e4f1-4d40-8c71-0d73de07f9e1", "text": "请留在您的座位上，直到我们到达终点站。", "shortMeaning": "请坐好别动，直到车到终点站。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:a6c5e64d-0d23-43e0-a612-48e1a29d7e97", "text": "请看屋顶上的那只猫。", "shortMeaning": "看屋顶上那只猫。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:90434fec-cd80-4737-824c-0d26c7116232", "text": "请看那座红屋顶的房子。", "shortMeaning": "看那座红屋顶的房子。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:c7fdcd3e-51a4-47dc-a0ed-87ee25fe63cf", "text": "请确认装置牢牢地固定在天花板上了。", "shortMeaning": "请确认装置已牢牢固定在天花板上。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:e0eb0cbe-9124-4342-82cc-fb5f6d2065b0", "text": "请给我一个汉堡包。", "shortMeaning": "请给我一个汉堡。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:a121fb8f-45aa-4283-ab18-46cd2ec3194d", "text": "请给我一张能写字的纸。", "shortMeaning": "给我一张能写字的纸吧。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:f9b73630-0b25-4080-b50d-a5d641d96a97", "text": "请给我一张芝加哥的往返票。", "shortMeaning": "请给我一张去芝加哥的往返票。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:d188723b-3e38-48d7-9166-378d6f5fb9a8", "text": "请给我一张街道地图好吗？", "shortMeaning": "能给我一张街道图吗？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:0e8fbc77-181e-48e2-9469-4249c5e7bef6", "text": "请给我一枚80日元的邮票。", "shortMeaning": "请给我一张80日元的邮票。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:34d00e20-429b-4906-9330-c84b3a2e2de2", "text": "请给我两张到伦敦的成人票，三张儿童票。", "shortMeaning": "请给两张伦敦成人票、三张儿童票。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:ad2525da-7624-4b2d-97b7-94b7fcb4e03a", "text": "请给我两杯苹果汁。", "shortMeaning": "请来两杯苹果汁。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:fea2be92-c584-4d74-b8ff-a8bde5edb8df", "text": "请给我们两把刀和四把叉。", "shortMeaning": "请给我们两把刀、四把叉子。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:87e65f13-14b5-4549-8384-df6eca4fc85f", "text": "请给我同样的东西。", "shortMeaning": "请给我一样的东西。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:73954c94-e756-4553-a512-d64fb6ace398", "text": "请给我她的地址好吗？", "shortMeaning": "能把她的地址给我吗？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:7ce261b7-2096-47f3-bab0-0bf8a4402ec0", "text": "请给我找一把椅子。", "shortMeaning": "请帮我找把椅子。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:da97bb72-b8bc-4d6f-98af-c91f05b7c0ce", "text": "请给我找个漂亮女孩。", "shortMeaning": "请给我找个漂亮姑娘。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:06dd66d0-b147-42d1-bd2f-d5d768c94854", "text": "请给我拿一个冰袋来。", "shortMeaning": "请给我拿个冰袋。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:0ca5c8c8-2e7e-4fc3-a0b4-66c3764c5e0d", "text": "请给我最大的菠萝。", "shortMeaning": "请把最大的菠萝给我。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:cd1dd83a-b0f1-4866-9c50-07e99fc8217f", "text": "请给我看一下你的笔记本。", "shortMeaning": "让我看看你的笔记本。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:8fda8feb-29af-4f99-ac99-efd1b848dedc", "text": "请给我看看其他的。", "shortMeaning": "请把别的给我看看。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:0c04a476-d995-43bd-bc70-6a5ee7465506", "text": "请给我看看另一个。", "shortMeaning": "请给我看另一个。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:852b06da-cf34-4de5-a6c6-b97ebe793430", "text": "请给我看看您的护照。", "shortMeaning": "请把您的护照给我看。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:9f301f8a-c1ec-4fa5-a0f4-8880cbd110b4", "text": "请给我统统说清楚什么时候在哪里发生了什么事。", "shortMeaning": "请把何时何地出了什么事，全都讲清楚。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:05e4b5ad-cdae-4ee1-9128-91c81c210c74", "text": "请继续讲你的故事。", "shortMeaning": "请接着讲你的故事。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:b6452017-1eec-49dc-8e1e-c7b70a146ac9", "text": "请考虑一下，最大值在有些情况下是不存在的。", "shortMeaning": "请想想，有些情况下根本没有最大值。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:fd6f8bd0-a639-4137-8aca-19ee00bc7af1", "text": "请解释一下怎么才能到那儿？", "shortMeaning": "请说说怎样才能到那儿？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:a5f71272-2c36-4053-a4b4-31fd35991e88", "text": "请讲我一个故事吧。", "shortMeaning": "给我讲个故事吧。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:8a2bbcf3-ea12-4925-8e51-ccd35adeeae0", "text": "请试着用简单一点的词讲同样的话，好让我们的外国同事更好理解。", "shortMeaning": "请试着用简单的词说同样的话，好让外国同事听懂。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:7569dc5c-7f2a-4b68-a7f7-0b3824cbb335", "text": "请诸位斟满酒，为新郎和新娘干杯！", "shortMeaning": "请大家满上，为新郎新娘干杯！", "authoredOn": "2026-10-24"}
{"id": "official:sentence:8c8a200d-27fc-47ee-b89d-ee10174070dd", "text": "请跟我来，跟我们来！", "shortMeaning": "跟我来，跟我们走！", "authoredOn": "2026-10-24"}
{"id": "official:sentence:9c6c2054-e0dd-456e-9840-7f4374bdb6ea", "text": "请这首歌再唱一遍。", "shortMeaning": "这首歌请再唱一遍。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:4fc867ff-c940-4012-a668-38ceaa5129f8", "text": "请通知我何时开始。", "shortMeaning": "开始了请告诉我。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:8d6da6d1-eb12-41af-ad7d-89cbdbda1629", "text": "请问你在哪里工作？", "shortMeaning": "请问你在哪儿上班？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:91f555b8-cf12-49a7-879a-a6f9e3cc98bd", "text": "请问你是鹿鸣书店的老板吗？", "shortMeaning": "请问鹿鸣书店的老板是您吗？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:994dd311-3e63-438e-9967-9380acb8ca3a", "text": "请问您今天来这里做什么呢？", "shortMeaning": "请问您今天来这儿办什么事？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:1b9e1040-dc76-495e-83df-e8d16fcf4845", "text": "请问您是留学生吗？", "shortMeaning": "您是在这边读书的留学生吗？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:d6efa668-071a-44f0-b569-74be8f9cb65a", "text": "请问您能带我去机场吗？", "shortMeaning": "能请您带我去机场吗？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:12b5400c-9c40-438d-86c6-719ddd0d9925", "text": "请问最后一次开信箱在什么时间？", "shortMeaning": "请问上次开信箱是什么时候？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:dbf93c64-5fa9-4b93-bdcd-664b6a798f23", "text": "请问能给我一杯牛奶吗？", "shortMeaning": "能给我一杯牛奶吗？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:4b447937-f425-4d37-8b35-1248b8935c7e", "text": "请问，出租车站在哪里？", "shortMeaning": "请问出租车站在哪儿？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:d294434c-f84a-4106-9593-37c373dd74b7", "text": "请随您的便叫我一声。", "shortMeaning": "您方便时招呼我一声。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:76896667-018b-417c-ac9d-7b6b82866213", "text": "请顺着这条路一直往前走。", "shortMeaning": "顺这条路一直往前走。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:9bab32bd-ae75-49b2-8244-46c9ba9fceb7", "text": "诺曼底人在1066年占领了英国。", "shortMeaning": "诺曼人在1066年征服了英国。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:d94b8a33-2aa3-4024-90d0-5ad1c05fa12c", "text": "诺言就是用来打破的。", "shortMeaning": "承诺本来就是拿来违背的。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:2ee1cf5b-a25e-42e9-ab81-8c4376d9928c", "text": "读书是人生一大快事。", "shortMeaning": "读书是人生的大乐事。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:c0c7cb85-b8a9-4877-9aae-9a444b32c232", "text": "读书，可以获得乐趣、友谊、经验和指导。", "shortMeaning": "读书能得到乐趣、友谊、经验和指点。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:79afebfe-b473-4602-9cd6-b30c238a9791", "text": "读这样的书会对今后的生活会有用。", "shortMeaning": "读这类书对日后生活有用。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:9bfba1f4-889d-4e47-a2d9-0f902dced308", "text": "读这种的书有什么用？", "shortMeaning": "读这种书有什么用？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:bd771d5b-bf54-43b0-9a51-f8041dd1c731", "text": "课开始了，请大家坐好。", "shortMeaning": "要上课了，大家请坐好。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:c58e1191-34c6-4700-ada7-9f3da686d455", "text": "谁不知道这个问题啊！", "shortMeaning": "这问题谁不知道！", "authoredOn": "2026-10-24"}
{"id": "official:sentence:0660f88c-ba00-4c23-bda2-b4ac6a028be9", "text": "谁也不想谈论这事。", "shortMeaning": "这事没人愿意谈。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:57273fcb-d996-4bd4-9d46-2f5d5edd5d81", "text": "谁也不知道他是否爱她。", "shortMeaning": "他到底爱不爱她，谁也不知道。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:8f9c77e1-8adb-49df-9340-cc365dcbd712", "text": "谁也不能阻止这个计划的实行。", "shortMeaning": "这计划谁也拦不住。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:ef72a595-4fe6-4dc6-a84c-c095f7f2cca7", "text": "谁也没跟我说什么。", "shortMeaning": "没人对我说过什么。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:d1a71311-c882-40d7-b5bf-dbc4c597474a", "text": "谁人不知，最爱卖弄的就是他！", "shortMeaning": "谁都知道，最爱显摆的就是他！", "authoredOn": "2026-10-24"}
{"id": "official:sentence:b4c82dca-2684-4f73-9a52-c66186378397", "text": "谁付了你的教育费？", "shortMeaning": "你的学费是谁出的？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:e8153b35-7c40-4aa5-994e-d43d1f0a7ceb", "text": "谁会和我一起唱歌？", "shortMeaning": "谁来跟我一起唱？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:d7a67d01-cec4-47e0-9ac4-4305d703ff2d", "text": "谁会禁止这样的事情呢？", "shortMeaning": "这种事谁会去禁？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:a5a790fe-5d97-4dba-a844-1fa0e5869ba6", "text": "谁会读那么厚的一本书呢？", "shortMeaning": "那么厚的书谁读得下去？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:52677212-00ed-4457-a042-4941b6f5b299", "text": "谁又在背后说你坏话了？没人敢吧。", "shortMeaning": "又是谁在背后讲你坏话？没人敢吧。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:8065aa0c-e12a-4f15-8020-b32fcefc4373", "text": "谁发明了第一辆汽车？", "shortMeaning": "头一辆汽车是谁造的？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:df0d98ec-d23e-497c-b97c-45c9f3fe4d00", "text": "谁告诉你，我提起过你。", "shortMeaning": "谁跟你说我提过你。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:3a47ebe7-3559-40c2-8563-09c2df54e6fd", "text": "谁想来你就带谁来。", "shortMeaning": "想来的人你都可以带上。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:82e58464-cd06-48f5-8b62-54da09aca174", "text": "谁把中文和日文都会说吧？", "shortMeaning": "谁中、日文都会说？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:594ee042-90db-46ca-ae68-f8a681bb4b1e", "text": "谁把我的皮包拿走了？", "shortMeaning": "谁把我的包拿走了？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:adcaa388-fc4e-4c11-aeb1-ae8838cae44f", "text": "谁把所有的曲奇都吃了？", "shortMeaning": "饼干是谁全吃光的？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:d8e1bb67-5d21-4d03-b724-7de1b23a2635", "text": "谁把电视插头拔了？", "shortMeaning": "电视插头是谁拔的？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:f369219c-a365-4f8d-8948-6caba17a2a9b", "text": "谁是你最喜爱的电视明星？", "shortMeaning": "你最喜欢的电视明星是谁？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:03aecc10-63ff-4cf5-97a7-8218686da0fb", "text": "谁更年轻，他还是我？", "shortMeaning": "他和我谁更年轻？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:8b9632d5-dc54-4bf4-b2d4-f0b1795adf3c", "text": "谁朝我的狗扔的石子？", "shortMeaning": "谁朝我的狗扔石头？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:34992328-d23f-4b70-91a0-7e862a402e2d", "text": "谁来为风险投资提供资金？", "shortMeaning": "风险投资的钱由谁出？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:37924523-f233-488b-b03a-40f99c51fb5d", "text": "谁来告诉我到底发生了什么事？", "shortMeaning": "谁来告诉我究竟出了什么事？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:619b3599-5859-43c4-aa68-44d5eedacf41", "text": "谁比较高，你还是我？", "shortMeaning": "你和我谁更高？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:2b0d8d17-cac1-4206-a2f2-7511176fe09a", "text": "谁没有在截稿日拼过命？", "shortMeaning": "谁没在截稿前拼命赶过？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:82156835-506f-4867-aa47-389a146659ab", "text": "谁理他！我理也不要理他！", "shortMeaning": "谁搭理他！我才不理他！", "authoredOn": "2026-10-24"}
{"id": "official:sentence:115323ec-9633-4ad8-b528-3de583829f36", "text": "谁的英语都比不上他。", "shortMeaning": "谁的英语都不如他。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:9dc22b96-708c-4f7e-81ec-26bef10c2356", "text": "谁知道胡锦涛的生日？", "shortMeaning": "有人知道胡锦涛的生日吗？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:51ab7399-755d-479d-a109-ed84c8d799ff", "text": "谁给了你这些东西？", "shortMeaning": "这些东西是谁给你的？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:250f598a-b09f-4be0-acfe-3ae50de8b68b", "text": "谁能告诉我什么是悲喜剧吗？", "shortMeaning": "谁能讲讲什么叫悲喜剧？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:015aff10-edd1-4a12-825f-dc8cbf1f36e3", "text": "谁能揭开海洋的奥秘？", "shortMeaning": "海洋的奥秘谁能揭开？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:b0645702-e0e8-4e8b-812f-80df542db27f", "text": "谁能融化你的铁石心肠？", "shortMeaning": "谁能让你的硬心肠软下来？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:2e38d976-ddf6-4fdb-93d7-59af2d135c16", "text": "谁能解释喧闹声和噪音之间的不同？", "shortMeaning": "喧闹和噪音的区别，谁能说清？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:23e81ed1-4314-42ba-90c7-307c2870477a", "text": "谁能说将来会发生什么呢。", "shortMeaning": "将来会怎样，谁也说不准。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:ff7412ad-4b37-419a-83f5-8b71297b2319", "text": "谁能赢这场比赛还说不定。", "shortMeaning": "这场球谁赢还难说。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:43061da0-9a25-4024-9f93-4bf92a3d05c6", "text": "谁要是忽略这一点，谁就得犯错误。", "shortMeaning": "谁忽略这一条，谁就要犯错。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:52829c76-eb1c-4b17-be1b-8e08f87b7ad9", "text": "谁诗你最喜欢的老师？", "shortMeaning": "你最喜欢的老师是谁？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:020d6ec0-756c-4f2c-9f12-4b26fb329c43", "text": "谁跟你说用左手写字的？", "shortMeaning": "谁教你用左手写字的？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:71d92f81-7355-448c-9927-ef8e3c475fa9", "text": "谁还会花时间给朋友写一封长信呢？", "shortMeaning": "如今谁还肯花工夫给朋友写长信？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:4027dacd-1c3d-4259-8738-556d896e5294", "text": "谁这么说说得不对。", "shortMeaning": "这么说的人说得不对。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:2a1f031c-494f-4535-8624-87575684b7e8", "text": "谁选你来做这个任务？", "shortMeaning": "这个任务是谁派给你的？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:50961a9e-e4e1-4fe8-94a8-1f01242e0771", "text": "谁都希望世界和平。", "shortMeaning": "人人都盼世界和平。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:d9eb0340-92c2-431f-8b21-cfba2df62c69", "text": "谁都想活得长久，但没人想变老。", "shortMeaning": "人都想活得久，却没人愿意变老。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:02aefcd3-4551-45c9-8a60-3752b3389c66", "text": "谁都有保护自己的权利。", "shortMeaning": "人人都有自保的权利。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:3b849354-f8b7-4e42-a97d-a8a6e257e138", "text": "谁都知道知足常乐。", "shortMeaning": "谁都知道知足才常乐。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:228e7d5e-abe6-437f-bd11-8dcb615b7f42", "text": "谈严肃的事时要严肃。", "shortMeaning": "说正经事就得有正经样。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:5a2de1f0-b8f3-4a2f-87c3-63286486c396", "text": "谈判正缓缓展开着。", "shortMeaning": "谈判正一点点推进。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:a030839c-28c0-456f-bc11-e4d740672bed", "text": "谋事在人，成事在天。", "shortMeaning": "事情靠人谋划，成不成看天。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:6cafd892-70f4-4f8a-b777-e9c7eddcb2fd", "text": "谢谢你烤的美味蛋糕。", "shortMeaning": "谢谢你烤的蛋糕，真好吃。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:63ab098e-a2f5-45fc-a747-60e18f320325", "text": "谢谢你的圣诞节礼物。", "shortMeaning": "谢谢你的圣诞礼物。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:80186f35-c67c-46a2-98ca-da9285e64d04", "text": "谢谢你跟我分享你的丈夫。", "shortMeaning": "谢谢你愿意跟我分享你的丈夫。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:9984d75a-895e-4560-ab0f-70064f54ac2d", "text": "谢谢你送给我儿子礼物。", "shortMeaning": "谢谢你给我儿子送礼物。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:f78001ad-963f-4177-9e2a-f471872a1fd0", "text": "谢谢你送给我这么漂亮的礼物！", "shortMeaning": "谢谢你送我这么好看的礼物！", "authoredOn": "2026-10-24"}
{"id": "official:sentence:9ff7112c-6e77-4629-84e8-05e3233e67db", "text": "谢谢你邀请我吃饭。", "shortMeaning": "谢谢你请我吃饭。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:97395b15-e1a4-4e8e-8317-e0a49dd7c20d", "text": "谢谢您在百忙之中抽出时间回复我的信件。", "shortMeaning": "谢谢您百忙中抽空回我的信。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:8b275efb-e9de-49a6-9210-05e7a6932c27", "text": "谢谢，我会努力的，不要让你失望才好。", "shortMeaning": "谢谢，我会使劲，但愿不让你失望。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:b0b75a5b-b970-4fb4-83b5-877173724270", "text": "谢谢，没时间了，我只要揉揉背和腰就好。", "shortMeaning": "谢谢，没时间了，我就揉揉背和腰。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:7a1fc5aa-4aba-4624-afab-723595c8097e", "text": "谣传一架宇宙飞船在上海附近被见到了。", "shortMeaning": "有传言说上海附近出现了飞船。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:97bbf87f-f624-49e5-84f8-6e7129c94c21", "text": "谣言不管听起来有多假，总有人会信。", "shortMeaning": "传言不管多离谱，总有人当真。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:253aecfc-9e14-4c67-b755-91f6e7f00198", "text": "谣言可能是真的吗？", "shortMeaning": "传言会是真的吗？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:1e2e8924-d1e7-4f0c-84c7-2395a474bda0", "text": "谣言最后被证明是假的。", "shortMeaning": "传言最后证实是假的。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:afac0a7c-fc20-4f26-b25e-c4dd41a9b339", "text": "谣言被爆是有根据的。", "shortMeaning": "有消息说那传言是有根据的。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:f3b1c89d-646d-4078-b9c9-b78104b92a02", "text": "谣言被证明是假的。", "shortMeaning": "那个传言被证伪了。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:4a3c5b78-e92b-414a-8ecf-6e8b953bed20", "text": "谨为另公子婚事献上由衷祝福。", "shortMeaning": "谨为令郎的婚事送上真心祝福。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:174ba519-99fc-4a9b-a1bc-5e18474196dd", "text": "貌似没有人知道真相。", "shortMeaning": "似乎没人知道实情。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:2250bb82-eb31-434c-b3ec-0342f3d3d6f4", "text": "贝先生，这长乐帮的帮主还是你来当吧。", "shortMeaning": "贝先生，长乐帮的帮主还是您来当。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:8e6e2018-cf94-4ad0-ac56-a92610363dd7", "text": "贝多芬走向钢琴，坐下来并开始弹。", "shortMeaning": "贝多芬走到钢琴前坐下，弹了起来。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:d5829172-ebcb-438e-8223-a5742ebcd0ed", "text": "贝尔在踢球时需要更加小心，因为他已经得了一次黄牌了。", "shortMeaning": "贝尔踢球得更小心，他已经吃过一张黄牌。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:48b6f6fe-9982-4a91-bc87-366d2a55832e", "text": "贝尔被犯规了，球队获得了任意球。", "shortMeaning": "贝尔被犯规，球队得了一个任意球。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:b06130d6-a567-4df7-95b6-397cfb508eee", "text": "贝贾亚在阿尔及利亚。", "shortMeaning": "贝贾亚位于阿尔及利亚。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:2f363ca4-973f-4143-94d1-b163e0ec9b60", "text": "财务主管是个很诚实的人。", "shortMeaning": "财务主管为人很诚实。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:50b402bd-e2f5-4ee1-be06-505e29e007c4", "text": "财富可以掩盖很多痛苦。", "shortMeaning": "钱财能遮住不少苦楚。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:143a0113-0631-40e4-b355-dd53ac462750", "text": "货是响当当的！我们从来不做一次性生意的。", "shortMeaning": "我们的货是过硬的！从不做一锤子买卖。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:2c897220-b648-4f21-b33e-4977f1927b24", "text": "货物毫无损坏地到达了。", "shortMeaning": "货物完好无损地到了。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:33575eb4-9f89-4242-a710-1955abc8f987", "text": "货物被封装进了板条箱里。", "shortMeaning": "货装进了板条箱。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:ae050b67-f0e8-4158-b41c-2f139742f31e", "text": "货物运到，我会通知你们的。", "shortMeaning": "货一到我就通知你们。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:5137c0ad-9394-4f11-b38b-81cb9c731e16", "text": "质数是大于一且只能被本身和一整除的自然数。", "shortMeaning": "质数是大于一、只能被1和自身整除的自然数。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:b92e98ca-7fd3-43b8-a2ab-69c19fef8a3f", "text": "贫困让他学会了自己解决问题。", "shortMeaning": "穷日子逼他自己想法子解决。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:b212bf7d-4268-4dcf-890b-76435c229647", "text": "贫困让他无法上学。", "shortMeaning": "家里穷，他上不了学。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:3da1280e-0670-4d7f-8fee-8302a4f39909", "text": "贫穷的不是拥有太少的人，而是想要太多的人。", "shortMeaning": "穷的不是占得少的人，而是想得多的人。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:9417285c-1136-474e-a58a-383aeab67344", "text": "贵族住在故宫的东边和西边。", "shortMeaning": "贵族住在故宫东西两侧。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:0110561f-489f-48eb-9f4b-40dcb9667962", "text": "贵重物品如果受损就会贬值。", "shortMeaning": "贵重物品一旦弄坏就不值钱了。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:e3f34d87-c82a-40fc-b475-373fd658e778", "text": "贸易帮助国家发展。", "shortMeaning": "贸易助推国家发展。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:17554711-691b-4352-9969-0b0cc64760b1", "text": "资产对所有者来说，具有盈利能力或一些其他的价值。", "shortMeaning": "资产对主人来说能生利，或有别的价值。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:e8a3b343-554d-4cca-9450-9bb835cbe0ce", "text": "资本、土地和劳动是生产的三大要素。", "shortMeaning": "资本、土地和劳动是生产三要素。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:a2e11ec5-3712-4118-847f-3a5d9672602d", "text": "资本家倾向于压榨工人。", "shortMeaning": "资本家倾向于榨取工人。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:779c37ec-52a8-47fd-b91f-b4a2a1937b65", "text": "赞扬比批评更容易让人接受。", "shortMeaning": "夸奖比批评更容易被人接受。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:89b3a1ae-5600-49b4-882c-b86c0eed3acd", "text": "赠与比接受更让人觉得幸福。", "shortMeaning": "给人东西比拿人东西更让人快活。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:270da169-4cda-418c-8c50-d996385c6373", "text": "赤道把地球分为两个半球。", "shortMeaning": "赤道把地球分成两半。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:67e18e34-7363-4fca-a8f6-3776cbf94729", "text": "走之前要确定关了火。", "shortMeaning": "出门前要确认火关了。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:cc78ec6b-08a6-46d2-9542-559c2e907e01", "text": "走到车站要花多少时间？", "shortMeaning": "走到车站要多久？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:37460e77-2b12-4b6e-a0dd-940b7068d019", "text": "走到那边一条小弄堂向左拐弯。", "shortMeaning": "走到那边一条小弄堂往左拐。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:78d5132a-4f73-4e14-8ba1-9caed811ff1e", "text": "走啊！大家可以开始走了！", "shortMeaning": "走吧！大家可以出发了！", "authoredOn": "2026-10-24"}
{"id": "official:sentence:50f2e02e-d3eb-457b-95a3-b3f9bc87aca1", "text": "走大概400公里的高速就可以穿过一个省。", "shortMeaning": "走约400公里高速就能穿过一个省。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:a07ce79d-d4cf-4f57-a772-11329b831a5f", "text": "走的那天，房间11点要空出来。", "shortMeaning": "退房那天十一点前要把房间腾出来。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:b6657f00-7b6d-4fc0-8344-eba2414c32c1", "text": "走自己的路，让别人去说吧。", "shortMeaning": "走自己的路，随别人怎么说。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:2acf26ae-042e-4b89-abd7-b97c11310642", "text": "走路的时候，视线不要离开你的包。", "shortMeaning": "走路时眼睛别离开自己的包。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:dcd97772-ced4-487c-a44f-7b7fcf355aec", "text": "赶快点，否则要错过公共汽车了。", "shortMeaning": "快点，不然赶不上公交车了。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:db00b70f-3931-48e0-94c6-17121ed6b5c6", "text": "起初他以为英语很难，如今他觉得很简单。", "shortMeaning": "他原以为英语很难，如今觉得很简单。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:08a858a6-fa61-4ed0-b353-20f514a3a213", "text": "起初的天灾迅速演变为了人祸。", "shortMeaning": "最初的天灾很快变成了人祸。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:a4c13c2c-9f69-4da6-af5d-bad90d7f8800", "text": "起码我的合同终止期在2012年7月呢，还早着呢！", "shortMeaning": "好歹我的合同到2012年7月才满，还早呢！", "authoredOn": "2026-10-24"}
{"id": "official:sentence:8728754a-f720-42d7-9cb1-02841536ae40", "text": "趁汤没凉之前喝下。", "shortMeaning": "趁汤还热把它喝了。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:7a8ba9f6-d517-4378-9f63-455d83cc684a", "text": "趁汤没凉，你把汤喝了。", "shortMeaning": "汤还没凉，你把它喝掉。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:01de815f-17c5-4a23-819c-249e4b1b0258", "text": "趁没忘呢，现在就做吧。", "shortMeaning": "趁还记得，现在就做。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:ea0966a7-e5a3-4bb6-b302-9dae6b043e5a", "text": "超市里卖的馒头没有自己做的好吃。", "shortMeaning": "超市卖的馒头不如自家做的好吃。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:b0962ba1-fbcc-4d27-b92b-89d0e1a80658", "text": "越南八月革命是一次民族解放革命。", "shortMeaning": "越南八月革命是一场民族解放革命。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:3d402144-1df9-4857-a0e0-532120cfb652", "text": "越想越搞不清楚了。", "shortMeaning": "越想越糊涂。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:58caab43-1026-4e28-9bc3-92442c1695a0", "text": "越是禁忌的事情越是让人趋之若鹜。", "shortMeaning": "越是被禁的事，人们越抢着去。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:d9481f7e-d22b-4e03-b68a-c3d02c423aec", "text": "越来越多的夫妻去国外度蜜月。", "shortMeaning": "去国外度蜜月的夫妻越来越多。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:f9efd11b-c79d-47f7-a993-bfeaf8028838", "text": "越来越多的情侣出国度蜜月。", "shortMeaning": "出国度蜜月的情侣一年比一年多。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:d016e269-5b05-4ee3-9607-256bed104776", "text": "越来越多的环保者开始宣传和使用以环保的无铅汽油为燃料的汽车。", "shortMeaning": "越来越多环保人士开始宣传使用烧无铅汽油的车。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:ebea0463-ad7f-425d-b5a3-cd22bae20caa", "text": "足球教练站在边线上对自己的队伍喊出指令。", "shortMeaning": "足球教练站在边线冲自己队喊话。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:579b2a15-0f6b-4d20-885b-77954f172c62", "text": "足球运动员可以挣很多钱。", "shortMeaning": "足球运动员能挣不少钱。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:9711731d-a14c-4d46-8a8b-4848b4fcc31d", "text": "距离令我满意的结果还很远。", "shortMeaning": "离让我满意的结果还差得远。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:4f8facf6-bd56-4d45-81c0-7a495798ab4f", "text": "跟一个只说“是”和“不是”的人很难继续谈话。", "shortMeaning": "跟只答“是”“不是”的人聊不下去。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:fd532333-6346-4cc5-955c-9c4e554f9046", "text": "跟上最近潮流时尚是件非常花钱的事儿。", "shortMeaning": "追最新时髦很烧钱。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:a69e747e-da5b-431a-8d82-89ae7a10300f", "text": "跟你共事总是很愉快。", "shortMeaning": "跟你一起干活总是很愉快。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:28ac8f4e-d06e-4beb-8254-5ccaf1d2f7af", "text": "跟你没半毛钱关系。", "shortMeaning": "这跟你一点关系都没有。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:1febf38d-d1d5-439f-9654-aff0b1a09844", "text": "跟其它的比，法国护照有多难看啊。", "shortMeaning": "比比别国的，法国护照真够难看。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:a8655c80-d177-49b9-afbd-e2acf18255d8", "text": "跟往常一样，他来迟了。", "shortMeaning": "他照旧迟到了。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:a5292d16-e195-4ec3-b11e-ca95bc6948c8", "text": "跟我一起来会不会麻烦你？", "shortMeaning": "跟我一起去会不会给你添麻烦？", "authoredOn": "2026-10-24"}
{"id": "official:sentence:98bab703-ae01-410c-a925-88c3f796e7c1", "text": "跟我们的房子比，你的就是个豪宅。", "shortMeaning": "跟我们家比，你这房子算豪宅。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:bd3bbe33-3174-4d82-933d-3136f5e185e6", "text": "跟我说说你的计划。", "shortMeaning": "说说你的计划吧。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:fdec079a-f2e5-4d83-b2a0-0148a234c50e", "text": "跟我说说您的计划。", "shortMeaning": "您把计划说给我听听。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:587090b0-8a78-4390-989f-8176369104a9", "text": "跟我还客气什么，咱俩谁跟谁啊。", "shortMeaning": "跟我客气啥，咱俩什么交情。", "authoredOn": "2026-10-24"}
{"id": "official:sentence:03a0a585-0a3e-41c1-adb3-216c97a890c9", "text": "路上都是灰，昨天肯定没下过雨。", "shortMeaning": "路上全是土，昨天准没下过雨。", "authoredOn": "2026-10-24"}
